# ─────────────────────────────────────────────────────────────────────────────
# COLOR – proměnné prostředí. Zkopírujte do .env.local a doplňte.
# NIKDY sem nevkládejte skutečné klíče; soubor je verzovaný jako šablona.
# ─────────────────────────────────────────────────────────────────────────────

# Veřejná adresa webu (bez lomítka na konci) – odkazy v e-mailech, sitemap, platební brány
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Volitelně samostatná doména pro Slovensko (jinak /sk/...)
NEXT_PUBLIC_SITE_URL_SK=
# Zapnutí slovenské verze (true/false)
NEXT_PUBLIC_ENABLE_SK=true

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Pouze server! Nikdy s prefixem NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Hlavní tajný klíč aplikace (min. 32 znaků, např. `openssl rand -base64 48`).
# Odvozují se z něj hashe IP adres (rate limiting bez ukládání IP) a přístupové odkazy k objednávkám.
# Změna klíče zneplatní odkazy na objednávky v již odeslaných e-mailech.
APP_SECRET=
# Tajný klíč pro Vercel Cron (Authorization: Bearer ...)
CRON_SECRET=

# E-maily (Resend). Bez klíče se e-maily jen zalogují (vývoj).
RESEND_API_KEY=
EMAIL_FROM="COLOR <objednavky@color.cz>"
EMAIL_REPLY_TO=podpora@color.cz

# Platební brány – vyplňte jen tu, kterou používáte (metoda „card“ v administraci)
COMGATE_MERCHANT_ID=
COMGATE_SECRET=
COMGATE_TEST=true
GOPAY_GOID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
GOPAY_SANDBOX=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Doprava – Zásilkovna/Packeta (widget + API)
NEXT_PUBLIC_PACKETA_API_KEY=
PACKETA_API_PASSWORD=
PACKETA_SENDER_LABEL=

# Analytika (spouští se až po souhlasu s cookies)
NEXT_PUBLIC_GA4_ID=

# Hlášení chyb (volitelné) – webhook, na který se POSTují serverové chyby (např. Slack, Better Stack)
ERROR_WEBHOOK_URL=

# Přihlášení přes Google (musí být povoleno i v Supabase Auth)
NEXT_PUBLIC_AUTH_GOOGLE=false

# Testy DB (lokální Supabase: postgresql://postgres:postgres@127.0.0.1:54322/postgres)
DATABASE_URL=
